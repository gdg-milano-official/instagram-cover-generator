# Generazione dei post con l'AI. Senza queste variabili l'app usa i testi da
# template e i pulsanti AI restano nascosti.
#
# Gemini (API key da Google Cloud Console, con la Generative Language API attiva):
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
#
# Azure AI Foundry (l'endpoint e' quello della risorsa, il modello e' il nome del deployment):
# AI_ENDPOINT=https://<tua-risorsa>.services.ai.azure.com/openai/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=<nome-del-deployment>
#
# Vanno bene anche i nomi AZURE_AI_FOUNDRY_ENDPOINT / _API_KEY / _MODEL.
